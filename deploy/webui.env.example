# Exact public origin. Use no trailing slash. With localhost-only SSH forwarding this can be omitted.
CODEX_WEBUI_ORIGIN=https://codex.example.com
CODEX_WEBUI_HOST=127.0.0.1
CODEX_WEBUI_PORT=3210
# Use the same absolute directory for the CLI and server.
# CODEX_WEBUI_DATA=/home/your-user/.local/share/codex-webui
